<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Inventario" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              language="java">
    <queryString><![CDATA[SELECT ingrediente, stock_actual, stock_minimo, unidad,
       CASE WHEN stock_actual < stock_minimo THEN 'CRITICO'
            WHEN stock_actual < stock_minimo * 1.2 THEN 'BAJO'
            ELSE 'OK' END as estado_stock,
       (stock_actual - stock_minimo) as diferencia
FROM inventario ORDER BY estado_stock, ingrediente]]></queryString>
    <field name="ingrediente" class="java.lang.String"/>
    <field name="stock_actual" class="java.math.BigDecimal"/>
    <field name="stock_minimo" class="java.math.BigDecimal"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="estado_stock" class="java.lang.String"/>
    <field name="diferencia" class="java.math.BigDecimal"/>
    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="782" height="35"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Inventario - Repostería Rosato]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="782" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </staticText>
        </band>
    </title>
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="302" height="25"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Ingrediente]]></text>
            </staticText>
            <staticText>
                <reportElement x="302" y="0" width="100" height="25"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Stock Actual]]></text>
            </staticText>
            <staticText>
                <reportElement x="402" y="0" width="100" height="25"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Stock Minimo]]></text>
            </staticText>
            <staticText>
                <reportElement x="502" y="0" width="80" height="25"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Unidad]]></text>
            </staticText>
            <staticText>
                <reportElement x="582" y="0" width="100" height="25"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Diferencia]]></text>
            </staticText>
            <staticText>
                <reportElement x="682" y="0" width="100" height="25"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="302" height="20"/>
                <textFieldExpression><![CDATA[$F{ingrediente}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="302" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{stock_actual}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="402" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{stock_minimo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="502" y="0" width="80" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{unidad}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="582" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{diferencia}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="682" y="0" width="100" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{estado_stock}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
