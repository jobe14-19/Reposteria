<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Limpieza" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              language="java">
    <parameter name="fechaDesde" class="java.util.Date"/>
    <parameter name="fechaHasta" class="java.util.Date"/>
    <queryString><![CDATA[SELECT l.id_limpieza, l.area, l.descripcion, l.responsable, l.fecha_limpieza
FROM limpieza l
WHERE ($P{fechaDesde} IS NULL OR l.fecha_limpieza >= $P{fechaDesde})
  AND ($P{fechaHasta} IS NULL OR l.fecha_limpieza <= $P{fechaHasta})
ORDER BY l.fecha_limpieza DESC]]></queryString>
    <field name="id_limpieza" class="java.lang.Integer"/>
    <field name="area" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="responsable" class="java.lang.String"/>
    <field name="fecha_limpieza" class="java.sql.Date"/>
    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="782" height="35"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Limpieza - Repostería Rosato]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="782" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="50" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="150" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Area]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="282" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Descripcion]]></text>
            </staticText>
            <staticText>
                <reportElement x="482" y="0" width="150" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Responsable]]></text>
            </staticText>
            <staticText>
                <reportElement x="632" y="0" width="150" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{id_limpieza}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{area}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="282" height="20"/>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="482" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{responsable}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="632" y="0" width="150" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{fecha_limpieza} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_limpieza}) : ""]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
