<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
               name="Factura" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="ID_FACTURA" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT id_factura, id_orden, cliente, telefono, direccion,
    fecha, subtotal, costo_delivery, itbis, descuento, total, estado,
    detalles, usuario_genera, fecha_generacion,
    ISNULL(metodo_pago, 'Efectivo') as metodo_pago, ISNULL(pagado, 'NO') as pagado
FROM facturas WHERE id_factura = $P{ID_FACTURA}]]></queryString>
	<field name="id_factura" class="java.lang.Integer"/>
	<field name="id_orden" class="java.lang.Integer"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<field name="costo_delivery" class="java.math.BigDecimal"/>
	<field name="itbis" class="java.math.BigDecimal"/>
	<field name="descuento" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="estado" class="java.lang.String"/>
	<field name="detalles" class="java.lang.String"/>
	<field name="usuario_genera" class="java.lang.String"/>
	<field name="fecha_generacion" class="java.sql.Timestamp"/>
	<field name="metodo_pago" class="java.lang.String"/>
	<field name="pagado" class="java.lang.String"/>
	<title>
		<band height="90" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="5" width="555" height="28" forecolor="#5D4037"/>
				<textElement textAlignment="Center"><font fontName="Arial" size="20" isBold="true"/></textElement>
				<text><![CDATA[REPOSTERÍA ROSATO]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="35" width="555" height="15" forecolor="#5D4037"/>
				<textElement textAlignment="Center"><font fontName="Arial" size="10" isItalic="true"/></textElement>
				<text><![CDATA[FACTURA]]></text>
			</staticText>
			<textField>
				<reportElement x="420" y="55" width="135" height="15"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10" isBold="true"/></textElement>
				<textFieldExpression><![CDATA["No. Factura: " + String.format("%06d", $F{id_factura})]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="420" y="70" width="135" height="15"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band height="80" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="5" width="80" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[Cliente:]]></text>
			</staticText>
			<textField>
				<reportElement x="85" y="5" width="250" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="22" width="80" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[Teléfono:]]></text>
			</staticText>
			<textField>
				<reportElement x="85" y="22" width="200" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="39" width="80" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[Dirección:]]></text>
			</staticText>
			<staticText>
				<reportElement x="85" y="39" width="300" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<text><![CDATA[Calle Dionisio Delgallido #2, Guayabal, Punal]]></text>
			</staticText>
			<staticText>
				<reportElement x="420" y="5" width="60" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[Fecha:]]></text>
			</staticText>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="485" y="5" width="70" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="420" y="22" width="60" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[Generó:]]></text>
			</staticText>
			<textField>
				<reportElement x="485" y="22" width="70" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{usuario_genera}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="420" y="39" width="60" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[Orden #:]]></text>
			</staticText>
			<textField>
				<reportElement x="485" y="39" width="70" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{id_orden} != null ? String.valueOf($F{id_orden}) : ""]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="56" width="80" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[M. Pago:]]></text>
			</staticText>
			<textField>
				<reportElement x="85" y="56" width="100" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{metodo_pago} != null ? $F{metodo_pago} : "Efectivo"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="200" y="56" width="80" height="15" forecolor="#5D4037"/>
				<textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
				<text><![CDATA[Pagado:]]></text>
			</staticText>
			<textField>
				<reportElement x="285" y="56" width="100" height="15"/>
				<textElement><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA["SI".equals($F{pagado}) ? "SI" : "NO"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="70" width="555" height="1" forecolor="#5D4037"/>
			</line>
		</band>
	</pageHeader>
	<columnHeader>
		<band height="25" splitType="Stretch">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="25" forecolor="#5D4037" backcolor="#FFE7ED"/>
			</rectangle>
			<staticText>
				<reportElement x="10" y="4" width="80" height="17" forecolor="#5D4037"/>
				<textElement verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement>
				<text><![CDATA[Concepto]]></text>
			</staticText>
			<staticText>
				<reportElement x="355" y="4" width="90" height="17" forecolor="#5D4037"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="10" isBold="true"/></textElement>
				<text><![CDATA[Monto]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="25" splitType="Stretch">
			<line>
				<reportElement x="0" y="0" width="555" height="1" forecolor="#E0E0E0"/>
			</line>
			<textField>
				<reportElement x="10" y="4" width="330" height="17"/>
				<textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{detalles} != null ? $F{detalles} : "Orden de producción #" + $F{id_orden}]]></textFieldExpression>
			</textField>
			<textField pattern="RD$ #,##0.00">
				<reportElement x="350" y="4" width="95" height="17"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement>
				<textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band height="120" splitType="Stretch">
			<line>
				<reportElement x="0" y="0" width="555" height="1" forecolor="#5D4037"/>
			</line>
			<staticText>
				<reportElement x="350" y="8" width="85" height="16" forecolor="#5D4037"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[Subtotal:]]></text>
			</staticText>
			<textField pattern="RD$ #,##0.00">
				<reportElement x="440" y="8" width="110" height="16"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="350" y="26" width="85" height="16" forecolor="#5D4037"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[Delivery:]]></text>
			</staticText>
			<textField pattern="RD$ #,##0.00">
				<reportElement x="440" y="26" width="110" height="16"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<textFieldExpression><![CDATA[$F{costo_delivery}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="350" y="44" width="85" height="16" forecolor="#5D4037"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[ITBIS (18%):]]></text>
			</staticText>
			<textField pattern="RD$ #,##0.00">
				<reportElement x="440" y="44" width="110" height="16"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<textFieldExpression><![CDATA[$F{itbis}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="350" y="62" width="85" height="16" forecolor="#5D4037"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<text><![CDATA[Descuento:]]></text>
			</staticText>
			<textField pattern="RD$ #,##0.00">
				<reportElement x="440" y="62" width="110" height="16"/>
				<textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
				<textFieldExpression><![CDATA[$F{descuento}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="350" y="80" width="200" height="1" forecolor="#5D4037"/>
			</line>
			<staticText>
				<reportElement x="350" y="85" width="85" height="20" forecolor="#5D4037"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="12" isBold="true"/></textElement>
				<text><![CDATA[TOTAL:]]></text>
			</staticText>
			<textField pattern="RD$ #,##0.00">
				<reportElement x="440" y="85" width="110" height="20" forecolor="#5D4037"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="12" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>