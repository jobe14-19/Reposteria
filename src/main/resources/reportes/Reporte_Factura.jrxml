<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
               name="Reporte_Factura_Dinamico" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" >
	<parameter name="ID_FACTURA" class="java.lang.Integer"/>
<queryString language="sql"><![CDATA[SELECT
    p.id_pedido as id_factura,
    CAST(p.fecha_pedido AS DATE) as fecha_venta,
    CAST(p.fecha_entrega AS DATE) as fecha_entrega,
    p.estado,
    c.nombre + ' ' + c.apellido as nombre_cliente,
    ISNULL(c.direccion, '') as direccion,
    ISNULL(c.telefono, '') as telefono,
    pr.nombre as producto_nombre,
    p.libras as cantidad,
    CASE WHEN p.libras > 0 THEN p.total / p.libras ELSE 0 END as precio_unitario,
    p.total as subtotal,
    p.total as total_pago,
    (SELECT TOP 1 metodo_pago FROM pagos WHERE id_pedido = p.id_pedido ORDER BY fecha_pago DESC) as metodo_pago
FROM pedidos p
INNER JOIN clientes c ON p.id_cliente = c.id_cliente
INNER JOIN productos pr ON p.id_producto = pr.id_producto
WHERE p.id_pedido = $P{ID_FACTURA}
ORDER BY p.id_pedido DESC]]></queryString>
	<field name="id_factura" class="java.lang.Integer"/>
	<field name="fecha_venta" class="java.sql.Date"/>
	<field name="fecha_entrega" class="java.sql.Date"/>
	<field name="estado" class="java.lang.String"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="producto_nombre" class="java.lang.String"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
	<field name="precio_unitario" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<field name="total_pago" class="java.math.BigDecimal"/>
	<field name="metodo_pago" class="java.lang.String"/>
