<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Personal" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              language="java">
    <parameter name="area" class="java.lang.String"/>
    <queryString><![CDATA[SELECT e.id_empleado, e.nombre, e.cedula, e.telefono, e.edad,
       e.genero, e.area, e.estado, e.salario, e.disponibilidad,
       (SELECT COUNT(*) FROM capacitaciones WHERE id_empleado = e.id_empleado) as capacitaciones
FROM empleados e
WHERE ($P{area} IS NULL OR $P{area} = '' OR e.area = $P{area})
ORDER BY e.area, e.nombre]]></queryString>
    <field name="id_empleado" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="cedula" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="edad" class="java.lang.Integer"/>
    <field name="genero" class="java.lang.String"/>
    <field name="area" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="salario" class="java.math.BigDecimal"/>
    <field name="disponibilidad" class="java.lang.String"/>
    <field name="capacitaciones" class="java.lang.Integer"/>
    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="782" height="35"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Personal - Repostería Rosato]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="782" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="50" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="152" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>
            <staticText>
                <reportElement x="202" y="0" width="90" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Cedula]]></text>
            </staticText>
            <staticText>
                <reportElement x="292" y="0" width="80" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Telefono]]></text>
            </staticText>
            <staticText>
                <reportElement x="372" y="0" width="80" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Area]]></text>
            </staticText>
            <staticText>
                <reportElement x="452" y="0" width="60" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
            <staticText>
                <reportElement x="512" y="0" width="100" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Salario]]></text>
            </staticText>
            <staticText>
                <reportElement x="612" y="0" width="80" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Disponib.]]></text>
            </staticText>
            <staticText>
                <reportElement x="692" y="0" width="90" height="25"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Capacitac.]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{id_empleado}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="152" height="20"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="202" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{cedula}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="292" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="372" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{area}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="452" y="0" width="60" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="512" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["RD$ " + $F{salario}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="612" y="0" width="80" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{disponibilidad}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="692" y="0" width="90" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{capacitaciones}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
