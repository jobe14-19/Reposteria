<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="FacturaPedido" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail" language="java">
    <parameter name="idPedido" class="java.lang.Integer"/>
    <queryString><![CDATA[SELECT p.id_pedido, c.nombre + ' ' + ISNULL(c.apellido, '') as cliente, c.telefono,
       c.direccion, c.rnc, p.fecha_pedido, p.fecha_entrega, pr.nombre as producto,
       p.libras, p.total, p.adelanto, (p.total - ISNULL(p.adelanto, 0)) as saldo,
       p.estado, p.observaciones
FROM pedidos p
JOIN clientes c ON p.id_cliente = c.id_cliente
JOIN productos pr ON p.id_producto = pr.id_producto
WHERE p.id_pedido = $P{idPedido}]]></queryString>
    <field name="id_pedido" class="java.lang.Integer"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>
    <field name="rnc" class="java.lang.String"/>
    <field name="fecha_pedido" class="java.sql.Timestamp"/>
    <field name="fecha_entrega" class="java.sql.Timestamp"/>
    <field name="producto" class="java.lang.String"/>
    <field name="libras" class="java.math.BigDecimal"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="adelanto" class="java.math.BigDecimal"/>
    <field name="saldo" class="java.math.BigDecimal"/>
    <field name="estado" class="java.lang.String"/>
    <field name="observaciones" class="java.lang.String"/>
    <title>
        <band height="120">
            <staticText>
                <reportElement x="0" y="0" width="535" height="40"/>
                <textElement textAlignment="Center">
                    <font size="22" isBold="true"/>
                </textElement>
                <text><![CDATA[Repostería Rosato]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="40" width="535" height="25"/>
                <textElement textAlignment="Center">
                    <font size="14"/>
                </textElement>
                <text><![CDATA[Factura - Pedido #]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="40" width="100" height="25"/>
                <textElement textAlignment="Left">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id_pedido}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="80" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[RNC: 1-31-12345-6 | Tel: 809-555-0000 | Av. Principal #100, Santo Domingo]]></text>
            </staticText>
        </band>
    </title>
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="267" height="20"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Información del Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement x="267" y="0" width="268" height="20"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Detalles del Pedido]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="200">
            <frame>
                <reportElement x="0" y="0" width="267" height="160"/>
                <staticText>
                    <reportElement x="5" y="5" width="80" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Cliente:]]></text>
                </staticText>
                <textField>
                    <reportElement x="85" y="5" width="177" height="15"/>
                    <textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="25" width="80" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[RNC:]]></text>
                </staticText>
                <textField>
                    <reportElement x="85" y="25" width="177" height="15"/>
                    <textFieldExpression><![CDATA[$F{rnc}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="45" width="80" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Teléfono:]]></text>
                </staticText>
                <textField>
                    <reportElement x="85" y="45" width="177" height="15"/>
                    <textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="65" width="80" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Dirección:]]></text>
                </staticText>
                <textField>
                    <reportElement x="85" y="65" width="177" height="15"/>
                    <textFieldExpression><![CDATA[$F{direccion}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="90" width="80" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Fecha Pedido:]]></text>
                </staticText>
                <textField>
                    <reportElement x="85" y="90" width="177" height="15"/>
                    <textFieldExpression><![CDATA[$F{fecha_pedido} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_pedido}) : ""]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement x="267" y="0" width="268" height="160"/>
                <staticText>
                    <reportElement x="5" y="5" width="100" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Producto:]]></text>
                </staticText>
                <textField>
                    <reportElement x="105" y="5" width="158" height="15"/>
                    <textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="25" width="100" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Libras:]]></text>
                </staticText>
                <textField>
                    <reportElement x="105" y="25" width="158" height="15"/>
                    <textFieldExpression><![CDATA[$F{libras}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="45" width="100" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Fecha Entrega:]]></text>
                </staticText>
                <textField>
                    <reportElement x="105" y="45" width="158" height="15"/>
                    <textFieldExpression><![CDATA[$F{fecha_entrega} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_entrega}) : ""]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="65" width="100" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Estado:]]></text>
                </staticText>
                <textField>
                    <reportElement x="105" y="65" width="158" height="15"/>
                    <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement x="5" y="90" width="100" height="15"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Observaciones:]]></text>
                </staticText>
                <textField>
                    <reportElement x="105" y="90" width="158" height="30"/>
                    <textFieldExpression><![CDATA[$F{observaciones}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </detail>
    <summary>
        <band height="120">
            <line>
                <reportElement x="300" y="0" width="235" height="1"/>
            </line>
            <staticText>
                <reportElement x="300" y="10" width="150" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Total:]]></text>
            </staticText>
            <textField>
                <reportElement x="450" y="10" width="85" height="20"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + $F{total}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="35" width="150" height="20"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <text><![CDATA[Adelanto:]]></text>
            </staticText>
            <textField>
                <reportElement x="450" y="35" width="85" height="20"/>
                <textElement textAlignment="Right">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + $F{adelanto}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="60" width="150" height="20"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Saldo Pendiente:]]></text>
            </staticText>
            <textField>
                <reportElement x="450" y="60" width="85" height="20"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true" forecolor="#CC0000"/>
                </textElement>
                <textFieldExpression><![CDATA["RD$ " + $F{saldo}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
