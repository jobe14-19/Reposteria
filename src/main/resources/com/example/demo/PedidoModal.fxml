<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.PedidoModalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Title -->
    <Label fx:id="tituloLabel" text="📋 Nuevo Pedido" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
        <Label text="Cliente:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="clienteComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Fecha Entrega:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="fechaEntregaPicker" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Tipo Bizcocho:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="tipoBizcochoComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Libras:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Spinner fx:id="librasSpinner" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1">
            <valueFactory>
                <SpinnerValueFactory.DoubleSpinnerValueFactory min="0.5" max="20.0" initialValue="1.0" amountToStepBy="0.5"/>
            </valueFactory>
        </Spinner>

        <Label text="Diseño:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextArea fx:id="disenoTextArea" promptText="Describe el diseño del pastel (obligatorio)" styleClass="form-field" prefWidth="250" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Diseño Complejo:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <CheckBox fx:id="disenoComplejoCheckBox" text="Mostrar campo colaborador" styleClass="form-field" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Total:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="totalField" styleClass="form-field" prefWidth="250" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Adelanto (50%):" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="adelantoField" styleClass="form-field" prefWidth="250" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Observaciones:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextArea fx:id="observacionesTextArea" promptText="Notas adicionales sobre el pedido" styleClass="form-field" prefWidth="250" prefHeight="80" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Price Information -->
    <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #F8F9FA; -fx-background-radius: 8;">
        <Label text="💰 Información de Precio" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

        <GridPane hgap="10" vgap="10" alignment="CENTER_LEFT">
            <Label text="Precio Base:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="precioBaseField" styleClass="form-field" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Costo Diseño:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <TextField fx:id="costoDiseñoField" styleClass="form-field" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Total Calculado:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="totalCalculadoField" styleClass="form-field" prefWidth="150" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
        <Button fx:id="cancelarButton" text="Cancelar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="guardarResultado" text="Guardar" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
