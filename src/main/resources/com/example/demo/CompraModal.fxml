<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.CompraModalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <spacing>15</spacing>

    <!-- Title -->
    <Label fx:id="tituloLabel" text="🛒 Registrar Compra" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
        <Label text="Proveedor:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="proveedorComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Fecha Compra:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="fechaCompraPicker" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Productos:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.valignment="TOP"/>

        <TableView fx:id="productosTable" prefHeight="200" styleClass="purchase-table" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.rowSpan="2">
            <columns>
                <TableColumn fx:id="productoColumn" text="Producto" prefWidth="150"/>
                <TableColumn fx:id="cantidadColumn" text="Cantidad" prefWidth="100"/>
                <TableColumn fx:id="precioUnitarioColumn" text="Precio Unitario" prefWidth="100"/>
                <TableColumn fx:id="descuentoColumn" text="Descuento" prefWidth="80"/>
                <TableColumn fx:id="subtotalColumn" text="Subtotal" prefWidth="100"/>
                <TableColumn fx:id="accionesColumn" text="Acciones" prefWidth="80"/>
            </columns>
        </TableView>

        <Button text="➕ Agregar Producto" style="-fx-background-color: #8B5E3C; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;" onAction="#agregarProducto" GridPane.rowIndex="3" GridPane.columnIndex="0"/>

        <VBox spacing="10" style="-fx-background-color: #F8F9FA; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15;" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <GridPane hgap="15" vgap="10">
                <Label text="Producto:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="productoComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Cantidad:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="cantidadField" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Precio Unitario:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="precioUnitarioField" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <HBox spacing="20" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
                    <CheckBox fx:id="productoDelicadoCheckBox" text="Producto delicado"/>
                    <CheckBox fx:id="requiereRefrigeracionCheckBox" text="Requiere refrigeración"/>
                </HBox>

                <Label text="Descuento:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="descuentoField" styleClass="form-field" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: #E3F2FD; -fx-border-color: #8B5E3C; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15;" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="💰 Total Compra:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                <TextField fx:id="totalField" styleClass="form-field" prefWidth="200" editable="false"/>
            </HBox>
        </VBox>
    </GridPane>

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
        <Button fx:id="cancelarButton" text="Cancelar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="guardarResultado" text="Registrar Compra" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>