<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.RecetaModalController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

 <VBox spacing="15" styleClass="root" maxWidth="Infinity">
 <padding>
 <Insets top="20" right="20" bottom="20" left="20"/>
 </padding>

 <Label fx:id="tituloLabel" text="Nueva Receta" style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="text-heading-lg"/>

 <GridPane hgap="15" vgap="15" maxWidth="Infinity">
 <columnConstraints>
 <ColumnConstraints percentWidth="25"/>
 <ColumnConstraints percentWidth="75"/>
 </columnConstraints>
 <Label text="Producto:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
 <ComboBox fx:id="productoComboBox" maxWidth="Infinity" promptText="Seleccione un producto" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

 <Label text="Descripcion:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
 <TextArea fx:id="descripcionField" promptText="Instrucciones de preparacion" prefRowCount="3" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

 <Label text="Porciones:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
 <Spinner fx:id="porcionesSpinner" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
 </GridPane>

 <Label text="Ingredientes:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm"/>

 <TableView fx:id="ingredientesTable" prefHeight="250" maxWidth="Infinity" VBox.vgrow="ALWAYS">
 <columns>
 <TableColumn fx:id="seleccionColumn" text="Usar" prefWidth="55"/>
 <TableColumn fx:id="ingNombreColumn" text="Ingrediente" prefWidth="200"/>
 <TableColumn fx:id="ingCantidadColumn" text="Cantidad" prefWidth="120"/>
 <TableColumn fx:id="ingUnidadColumn" text="Unidad" prefWidth="90"/>
 </columns>
 <placeholder>
 <Label text="No hay ingredientes disponibles." style="-fx-text-fill: #999; -fx-font-size: 13px;"/>
 </placeholder>
 </TableView>

 <HBox alignment="CENTER_RIGHT" spacing="10">
 <Button text="Cancelar" onAction="#cancelar" styleClass="btn-secondary"/>
 <Button fx:id="guardarButton" text="Guardar" onAction="#guardar" styleClass="btn-success"/>
 </HBox>
 </VBox>
</ScrollPane>
