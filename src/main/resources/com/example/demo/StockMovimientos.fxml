<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.StockMovimientosController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

  <VBox styleClass="bg-card border-bottom-light">
 <padding>
 <Insets top="20" right="20" bottom="15" left="20"/>
 </padding>
 <HBox alignment="CENTER_LEFT" spacing="15">
  <Label text="Movimientos de Stock" style="-fx-font-size: 24px;" styleClass="text-heading"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Button fx:id="refrescarButton" text="Refrescar" styleClass="btn-primary"/>
 </HBox>
 </VBox>

 <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="bg-primary">
 <VBox style="-fx-padding: 20; -fx-spacing: 20;" maxWidth="Infinity" alignment="TOP_CENTER">

 <VBox spacing="15" maxWidth="Infinity">
 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label text="Historial de Movimientos" styleClass="section-title"/>
 <Region HBox.hgrow="ALWAYS"/>
 <TextField fx:id="buscarField" promptText="Buscar por ingrediente, tipo, usuario..." styleClass="form-field" prefWidth="280"/>
 <Button fx:id="buscarButton" text="Buscar" styleClass="btn-secondary"/>
 </HBox>

 <TableView fx:id="movimientosTable" maxWidth="Infinity" prefHeight="400" VBox.vgrow="ALWAYS">
 <columns>
 <TableColumn fx:id="fechaColumn" text="Fecha/Hora" prefWidth="150"/>
 <TableColumn fx:id="ingredienteColumn" text="Ingrediente" prefWidth="180"/>
 <TableColumn fx:id="tipoColumn" text="Tipo" prefWidth="100"/>
 <TableColumn fx:id="cantidadColumn" text="Cantidad" prefWidth="100"/>
 <TableColumn fx:id="stockAntColumn" text="Stock Anterior" prefWidth="110"/>
 <TableColumn fx:id="stockNuevoColumn" text="Stock Nuevo" prefWidth="110"/>
 <TableColumn fx:id="motivoColumn" text="Motivo" prefWidth="200"/>
 <TableColumn fx:id="usuarioColumn" text="Usuario" prefWidth="130"/>
 </columns>
 </TableView>

 <HBox alignment="CENTER" spacing="10">
 <Button fx:id="anteriorButton" text="Anterior" styleClass="btn-secondary"/>
  <Label fx:id="paginaLabel" text="Página 1 de 1" style="-fx-font-size: 13px;" styleClass="text-heading"/>
 <Button fx:id="siguienteButton" text="Siguiente" styleClass="btn-secondary"/>
 <Region HBox.hgrow="ALWAYS"/>
  <Label fx:id="totalLabel" text="Total: 0 movimientos" style="-fx-font-size: 13px;" styleClass="text-muted"/>
 </HBox>
 </VBox>
 </VBox>
 </ScrollPane>
</VBox>
