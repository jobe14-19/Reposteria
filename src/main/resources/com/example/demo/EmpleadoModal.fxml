<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.EmpleadoModalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <spacing>15</spacing>

    <!-- Title -->
    <Label fx:id="tituloLabel" text="Contratar Empleado" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
        <Label text="Nombre completo*:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" promptText="Nombre completo del empleado" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Cédula*:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="cedulaField" promptText="Número de cédula" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Teléfono*:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="telefonoField" promptText="Número de teléfono" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Edad:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="edadField" promptText="Edad (mínimo 18 años)" styleClass="form-field" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Género:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="generoComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Área:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="areaComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Disponibilidad:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <ComboBox fx:id="disponibilidadComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Salario:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="salarioField" promptText="Salario mensual" styleClass="form-field" prefWidth="250" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Fecha Contratación:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <DatePicker fx:id="fechaContratacionPicker" styleClass="form-field" prefWidth="250" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

        <VBox fx:id="pregnancyTestSection" spacing="5" GridPane.rowIndex="9" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <Label text="Fecha Prueba Embarazo*:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
            <DatePicker fx:id="fechaPruebaEmbarazoPicker" styleClass="form-field" prefWidth="250"/>
        </VBox>
    </GridPane>

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
        <Button fx:id="cancelarButton" text="Cancelar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="guardarResultado" text="Guardar" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
