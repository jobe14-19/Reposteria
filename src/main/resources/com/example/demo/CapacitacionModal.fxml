<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>
<?import javafx.scene.text.Font?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.CapacitacionModalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <spacing>15</spacing>

    <!-- Title -->
    <Label fx:id="tituloLabel" text="📚 Registrar Capacitación">
        <font>
            <Font size="20" name="System Bold"/>
        </font>
        <style>-fx-text-fill: #8B5E3C;</style>
    </Label>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox spacing="15">
    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
        <!-- Fila 0 -->
        <Label text="Empleado:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="empleadoComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Fila 1 -->
        <Label text="Tema:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="temaField" promptText="Tema de la capacitación" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Fila 2 -->
        <Label text="Fecha:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="fechaPicker" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Fila 3 -->
        <Label text="Duración (horas):" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="duracionField" promptText="Duración en horas" styleClass="form-field" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Fila 4 -->
        <Label text="Capacitador:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="capacitadorField" promptText="Nombre del capacitador" styleClass="form-field" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Separador visual (opcional) -->
        <Separator GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2" />
    </GridPane>
        </VBox>
    </ScrollPane>

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
        <Button fx:id="limpiarButton" text="Limpiar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;" onAction="#limpiarCampos"/>
        <Button fx:id="cancelarButton" text="Cancelar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="guardarResultado" text="Registrar" style="-fx-background-color: #8B5E3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
