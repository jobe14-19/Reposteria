<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.LimpiezaModalController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

 <padding>
 <Insets top="20" right="20" bottom="20" left="20"/>
 </padding>

 <spacing>15</spacing>

 <!-- Title -->
 <Label fx:id="tituloLabel" text="Registrar Limpieza" style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>

 <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
 <VBox spacing="15">
 <!-- Form Fields -->
 <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
 <Label text="Área/Equipo:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
 <ComboBox fx:id="areaComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

 <Label text="Fecha:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
 <DatePicker fx:id="fechaPicker" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

 <Label text="Tipo:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
 <ComboBox fx:id="tipoComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

 <Label text="Responsables:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
 <ListView fx:id="responsablesListView" styleClass="form-field" prefWidth="250" prefHeight="100" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

 <Label text="Productos Utilizados:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
 <VBox fx:id="productosContainer" spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
 <Label text="Cargando..." style="-fx-font-size: 13px;" styleClass="text-muted-sm"/>
 </VBox>

 <Label text="Verificación:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
 <CheckBox fx:id="verificadoCheckBox" text="Verificado por supervisor" style="-fx-font-size: 14px; -fx-text-fill: #333333;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
 </GridPane>
 </VBox>
 </ScrollPane>

 <!-- Action Buttons -->
 <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
 <Button fx:id="limpiarButton" text="Limpiar" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;" onAction="#limpiarCampos"/>
 <Button fx:id="cancelarButton" text="Cancelar" onAction="#cancelarLimpieza" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button fx:id="guardarResultado" text="Registrar" onAction="#guardarLimpieza" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 </HBox>
</VBox>
