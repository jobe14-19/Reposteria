<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.IngredienteModalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <spacing>15</spacing>

    <!-- Title -->
    <Label fx:id="tituloLabel" text="✏️ Editar Ingrediente" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
        <Label text="Nombre:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" promptText="Nombre del ingrediente" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Categoría:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoriaComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Unidad:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="unidadField" promptText="Unidad (kg, lb, etc.)" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Stock Actual:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="stockActualField" promptText="Cantidad actual en stock" styleClass="form-field" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Stock Mínimo:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="stockMinimoField" promptText="Stock mínimo requerido" styleClass="form-field" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
        <Button fx:id="cancelarButton" text="Cancelar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="guardarResultado" text="Guardar" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
