<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.InventarioController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="20" right="20" bottom="15" left="20"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="Control de Inventario" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="registrarCompraButton" text="Registrar Compra" style="-fx-background-color: #8B5E3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="verHistorialButton" text="Ver Historial" style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="actualizarStockButton" text="✏️ Actualizar Stock" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: #FAFAFA;">
        <VBox style="-fx-padding: 20; -fx-spacing: 20;" alignment="TOP_CENTER">

            <!-- Alerts Section -->
            <VBox spacing="15" alignment="TOP_CENTER">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="⚠️ Alertas de Inventario" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="actualizarAlertasButton" text="🔄 Actualizar Alertas" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <ListView fx:id="alertasListView" prefHeight="150" style="-fx-background-color: #FFF3E0; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-border-radius: 6; -fx-padding: 5;"/>
            </VBox>

            <!-- Inventory Table -->
            <VBox spacing="15" alignment="TOP_CENTER">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="📋 Inventario de Ingredientes" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" text="Total: 0 ingredientes" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                </HBox>

                <TableView fx:id="ingredientesTable" styleClass="inventory-table">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="categoriaColumn" text="Categoría" prefWidth="120"/>
                        <TableColumn fx:id="unidadColumn" text="Unidad" prefWidth="80"/>
                        <TableColumn fx:id="stockActualColumn" text="Stock Actual" prefWidth="100"/>
                        <TableColumn fx:id="stockMinimoColumn" text="Stock Mínimo" prefWidth="100"/>
                        <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="100"/>
                        <TableColumn fx:id="accionesColumn" text="Acciones" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
