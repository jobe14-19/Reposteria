<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.InventarioController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

  <!-- Header -->
  <VBox styleClass="bg-card border-bottom-light">
  <padding>
  <Insets top="20" right="20" bottom="15" left="20"/>
  </padding>

  <HBox alignment="CENTER_LEFT" spacing="15">
  <Label text="Control de Inventario" style="-fx-font-size: 24px;" styleClass="text-heading"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Button fx:id="registrarCompraButton" text="Registrar Compra" onAction="#registrarCompra" style="-fx-background-color: #f55580; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button fx:id="verHistorialButton" text="Ver Historial" onAction="#verHistorial" style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button fx:id="actualizarStockButton" text="Movimientos" onAction="#actualizarStock" style="-fx-background-color: #f0ad4e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button text="Reporte" onAction="#exportarReporte" style="-fx-background-color: #6c4540; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 </HBox>
 </VBox>

 <!-- Main Content -->
  <ScrollPane fitToWidth="true" styleClass="bg-primary">
 <VBox style="-fx-padding: 20; -fx-spacing: 20;" alignment="TOP_CENTER">

 <!-- Alerts Section -->
 <VBox spacing="15" alignment="TOP_CENTER">
 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label text="Alertas de Inventario" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Button fx:id="actualizarAlertasButton" text="Actualizar Alertas" onAction="#actualizarAlertas" style="-fx-background-color: #f0ad4e; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;"/>
 </HBox>

  <ListView fx:id="alertasListView" prefHeight="150" style="-fx-background-color: #fcf4f0; -fx-border-radius: 6; -fx-padding: 5;" styleClass="border-light"/>
 </VBox>

 <!-- Inventory Table -->
 <VBox spacing="15" alignment="TOP_CENTER">
 <HBox alignment="CENTER_LEFT" spacing="15">
  <Label text="Inventario de Ingredientes" style="-fx-font-size: 18px;" styleClass="text-heading"/>
 <Region HBox.hgrow="ALWAYS"/>
  <Label fx:id="totalLabel" text="Total: 0 ingredientes" style="-fx-font-size: 14px;" styleClass="text-muted"/>
 </HBox>

 <TableView fx:id="ingredientesTable" styleClass="inventory-table">
 <columns>
 <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
 <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="150"/>
 <TableColumn fx:id="categoriaColumn" text="Categoría" prefWidth="120"/>
 <TableColumn fx:id="unidadColumn" text="Unidad" prefWidth="80"/>
 <TableColumn fx:id="stockActualColumn" text="Stock Actual" prefWidth="100"/>
 <TableColumn fx:id="stockMinimoColumn" text="Stock Mínimo" prefWidth="100"/>
 <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="100"/>
 <TableColumn fx:id="accionesColumn" text="Acciones" prefWidth="150"/>
 </columns>
 </TableView>
 </VBox>
 </VBox>
 </ScrollPane>
</VBox>
