<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.RecetasController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

 <VBox style="-fx-border-width: 0 0 1 0;" styleClass="bg-card border-light">
 <padding>
 <Insets top="20" right="20" bottom="15" left="20"/>
 </padding>
 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label text="Gestion de Recetas" style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Button text="Nueva Receta" onAction="#nuevaReceta" styleClass="btn-primary"/>
 </HBox>
 </VBox>

 <ScrollPane fitToWidth="true" styleClass="bg-primary">
 <VBox style="-fx-padding: 20; -fx-spacing: 20;" alignment="TOP_CENTER">

 <VBox spacing="15">
 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label text="Lista de Recetas" style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="text-heading-lg"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Label fx:id="totalLabel" text="Total: 0 recetas" style="-fx-font-size: 14px;" styleClass="text-muted-sm"/>
 </HBox>

 <TableView fx:id="recetasTable" styleClass="inventory-table">
 <columns>
 <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
 <TableColumn fx:id="productoColumn" text="Producto" prefWidth="200"/>
 <TableColumn fx:id="descripcionColumn" text="Descripcion" prefWidth="250"/>
 <TableColumn fx:id="porcionesColumn" text="Porciones" prefWidth="80"/>
 <TableColumn fx:id="ingredientesColumn" text="Ingredientes" prefWidth="100"/>
 <TableColumn fx:id="accionesColumn" text="Acciones" prefWidth="180"/>
 </columns>
 </TableView>
 </VBox>
 </VBox>
 </ScrollPane>
</VBox>
