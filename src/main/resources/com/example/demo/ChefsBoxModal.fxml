<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.ChefsBoxModalController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

 <padding>
 <Insets top="20" right="20" bottom="20" left="20"/>
 </padding>
 <spacing>15</spacing>

 <Label fx:id="tituloLabel" text="Nueva Caja Especial" style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>

 <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
 <Label text="Nombre:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
 <TextField fx:id="nombreField" promptText="Nombre de la caja" styleClass="form-field" prefWidth="300" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

 <Label text="Descripcion:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
 <TextArea fx:id="descripcionField" promptText="Descripcion de la caja" prefRowCount="3" prefWidth="300" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

 <Label text="Precio:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
 <TextField fx:id="precioField" promptText="0.00" styleClass="form-field" prefWidth="150" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

 <Label text="Disponible:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
 <CheckBox fx:id="disponibleCheckBox" selected="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
 </GridPane>

 <Label text="Productos incluidos:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm"/>

 <TableView fx:id="productosTable" prefHeight="200">
 <columns>
 <TableColumn fx:id="seleccionColumn" text="Incluir" prefWidth="60"/>
 <TableColumn fx:id="prodNombreColumn" text="Producto" prefWidth="180"/>
 <TableColumn fx:id="prodCantidadColumn" text="Cantidad" prefWidth="80"/>
 <TableColumn fx:id="prodPrecioColumn" text="P. Unitario" prefWidth="100"/>
 </columns>
 </TableView>

 <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 10;">
 <Button fx:id="cancelarButton" text="Cancelar" onAction="#cancelar" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button fx:id="guardarButton" text="Guardar" onAction="#guardar" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 </HBox>
</VBox>
