<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox styleClass="root" spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.MaterialModalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestión de Materiales" style="-fx-font-size: 20px;" styleClass="text-heading"/>

    <!-- Form -->
    <GridPane hgap="10" vgap="10" alignment="CENTER_LEFT">
        <Label text="Nombre:" styleClass="text-muted-sm" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreField" promptText="Nombre del material" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Unidad:" styleClass="text-muted-sm" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="unidadField" promptText="unidad, kg, lt, etc." prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Stock Actual:" styleClass="text-muted-sm" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="stockActualField" promptText="0" prefWidth="100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Stock Mínimo:" styleClass="text-muted-sm" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="stockMinimoField" promptText="1" prefWidth="100" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <Button fx:id="agregarButton" text="Agregar" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;" onAction="#agregarMaterial"/>
            <Button fx:id="actualizarButton" text="Actualizar" style="-fx-background-color: #f0ad4e; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;" onAction="#actualizarMaterial"/>
            <Button fx:id="limpiarFormButton" text="Limpiar" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;" onAction="#limpiarFormulario"/>
        </HBox>
    </GridPane>

    <!-- Table -->
    <TableView fx:id="materialesTable" prefHeight="250">
        <columns>
            <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="unidadColumn" text="Unidad" prefWidth="80"/>
            <TableColumn fx:id="stockActualColumn" text="Stock" prefWidth="80"/>
            <TableColumn fx:id="stockMinimoColumn" text="Stock Mínimo" prefWidth="100"/>
            <TableColumn fx:id="accionColumn" text="Acción" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cerrar" onAction="#cerrarModal" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
