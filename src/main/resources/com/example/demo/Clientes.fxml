<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import java.net.URL?>
<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.ClientesController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="20" right="20" bottom="15" left="20"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="👥 Gestión de Clientes" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="nuevoClienteButton" text="+ Nuevo Cliente" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Content -->
    <VBox style="-fx-padding: 20; -fx-spacing: 20;" alignment="TOP_CENTER">

        <!-- Search and Filters -->
        <HBox style="-fx-background-color: #F8F9FA; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-padding: 15;" alignment="CENTER_LEFT" spacing="20">

            <VBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🔍 Búsqueda" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="buscarField" promptText="🔍 Buscar por nombre, apellido o teléfono" styleClass="form-field" prefWidth="300"/>
                </HBox>
            </VBox>

            <VBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📊 Filtros" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                <HBox spacing="10" alignment="CENTER">
                    <VBox spacing="5">
                        <Label text="Estado Pedidos:" style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>
                        <ComboBox fx:id="estadoFilter" styleClass="form-field" prefWidth="150"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Fecha Desde:" style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>
                        <DatePicker fx:id="fechaDesdePicker" styleClass="form-field" prefWidth="150"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Fecha Hasta:" style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>
                        <DatePicker fx:id="fechaHastaPicker" styleClass="form-field" prefWidth="150"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="exportarButton" text="📄 Exportar Lista" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="actualizarButton" text="🔄 Actualizar Datos" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
        </HBox>

        <!-- Clients Table Section -->
        <VBox spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="Lista de Clientes" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                <Label fx:id="totalLabel" text="Total: 0 clientes" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="nuevoClienteButton2" text="+ Nuevo Cliente" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20;"/>
            </HBox>

            <TableView fx:id="clientesTable" styleClass="clients-table">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="apellidoColumn" text="Apellido" prefWidth="120"/>
                    <TableColumn fx:id="telefonoColumn" text="Teléfono" prefWidth="100"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="fechaRegistroColumn" text="Fecha Registro" prefWidth="120"/>
                    <TableColumn fx:id="pedidosColumn" text="Pedidos" prefWidth="80"/>
                    <TableColumn fx:id="accionesColumn" text="Acciones" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>