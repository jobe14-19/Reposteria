<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.ClientesController">
 <stylesheets>
 <URL value="@styles.css" />
 </stylesheets>

 <!-- Header -->
  <VBox styleClass="bg-card border-light" style="-fx-border-width: 0 0 1 0;">
 <padding>
 <Insets bottom="15" left="20" right="20" top="20" />
 </padding>

 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="text-heading" text="Gestión de Clientes" />
 <Region HBox.hgrow="ALWAYS" />
 </HBox>
 </VBox>

 <!-- Content -->
 <ScrollPane fitToWidth="true" styleClass="bg-primary" VBox.vgrow="ALWAYS">
 <VBox alignment="TOP_CENTER" style="-fx-padding: 20; -fx-spacing: 20;">

 <!-- Search and Filters -->
  <HBox alignment="CENTER_LEFT" spacing="20" styleClass="bg-input border-light" style="-fx-background-radius: 12; -fx-border-width: 1; -fx-padding: 15;">

 <VBox alignment="CENTER_LEFT" spacing="10">
  <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading" text="Búsqueda" />
 <HBox alignment="CENTER" spacing="10">
 <TextField fx:id="buscarField" prefWidth="300" promptText=" Buscar por nombre, apellido o teléfono" styleClass="form-field" />
 </HBox>
 </VBox>

 <VBox alignment="CENTER_LEFT" spacing="10">
  <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading" text="Filtros" />
 <HBox alignment="CENTER" spacing="10">
 <VBox spacing="5">
  <Label style="-fx-font-size: 12px;" styleClass="text-muted-sm" text="Estado Pedidos:" />
 <ComboBox fx:id="estadoFilter" prefWidth="150" styleClass="form-field" />
 </VBox>

 <VBox spacing="5">
  <Label style="-fx-font-size: 12px;" styleClass="text-muted-sm" text="Fecha Desde:" />
 <DatePicker fx:id="fechaDesdePicker" prefWidth="150" styleClass="form-field" />
 </VBox>

 <VBox spacing="5">
  <Label style="-fx-font-size: 12px;" styleClass="text-muted-sm" text="Fecha Hasta:" />
 <DatePicker fx:id="fechaHastaPicker" prefWidth="150" styleClass="form-field" />
 </VBox>
 </HBox>
 </VBox>
 </HBox>

 <!-- Action Buttons -->
 <HBox alignment="CENTER" spacing="10">
 <Region HBox.hgrow="ALWAYS" />
 <Button fx:id="actualizarButton" onAction="#actualizarDatos" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10 20 10 20;" text="Actualizar Datos" />
 </HBox>

 <!-- Clients Table Section -->
 <VBox spacing="15">
 <HBox alignment="CENTER_LEFT" spacing="15">
  <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="text-heading" text="Lista de Clientes" />
  <Label fx:id="totalLabel" style="-fx-font-size: 14px;" styleClass="text-muted" text="Total: 0 clientes" />
 <Region HBox.hgrow="ALWAYS" />
 <Button fx:id="nuevoClienteButton2" onAction="#nuevoCliente" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20;" text="+ Nuevo Cliente" />
 </HBox>

 <TableView fx:id="clientesTable" styleClass="clients-table">
 <columns>
 <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />
 <TableColumn fx:id="nombreColumn" prefWidth="150" text="Nombre" />
 <TableColumn fx:id="apellidoColumn" prefWidth="120" text="Apellido" />
 <TableColumn fx:id="telefonoColumn" prefWidth="100" text="Teléfono" />
 <TableColumn fx:id="emailColumn" prefWidth="180" text="Email" />
 <TableColumn fx:id="fechaRegistroColumn" prefWidth="120" text="Fecha Registro" />
 <TableColumn fx:id="pedidosColumn" prefWidth="80" text="Pedidos" />
 <TableColumn fx:id="accionesColumn" prefWidth="150" text="Acciones" />
 </columns>
 </TableView>
 </VBox>
 </VBox>
 </ScrollPane>
</VBox>
