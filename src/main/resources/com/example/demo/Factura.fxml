<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="15" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.FacturaController">
 <stylesheets><URL value="@styles.css"/></stylesheets>
 <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

 <HBox alignment="CENTER_LEFT" spacing="15">
  <Label text="Facturaci&oacute;n" styleClass="text-heading-lg"/>
  <Region HBox.hgrow="ALWAYS"/>
  <Button text="Generar Factura" fx:id="generarBtn" styleClass="btn-success"/>
  <Button text="Imprimir" fx:id="imprimirBtn" styleClass="btn-primary"/>
 </HBox>

 <Separator styleClass="separator-accent"/>

 <HBox spacing="20" alignment="CENTER">
  <VBox spacing="10" HBox.hgrow="ALWAYS">
   <Label text="Datos de la Empresa" styleClass="text-heading-sm"/>
   <VBox styleClass="card-bordered" spacing="4">
    <Label text="Reposter&iacute;a Rosato" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e8476f;"/>
    <Label text="RNC: 1-31-12345-6" styleClass="text-muted-sm"/>
    <Label text="Direcci&oacute;n: Av. Principal #123, Santo Domingo" styleClass="text-muted-sm"/>
    <Label text="Tel: (809) 555-1234" styleClass="text-muted-sm"/>
   </VBox>
  </VBox>
  <VBox spacing="10" HBox.hgrow="ALWAYS">
   <Label text="Buscar Orden" styleClass="text-heading-sm"/>
   <HBox spacing="10" alignment="CENTER_LEFT">
    <TextField fx:id="buscarField" promptText="N&uacute;mero de orden o cliente..." styleClass="form-field" HBox.hgrow="ALWAYS"/>
    <Button text="Buscar" fx:id="buscarBtn" styleClass="btn-primary"/>
   </HBox>
   <Label fx:id="ordenInfoLabel" text="Seleccione una orden para facturar" styleClass="text-muted"/>
  </VBox>
 </HBox>

 <Separator styleClass="separator-accent"/>

 <TableView fx:id="facturasTable" VBox.vgrow="ALWAYS" prefHeight="300" styleClass="delivery-table">
  <columns>
   <TableColumn fx:id="factIdColumn" text="Factura #" prefWidth="100"/>
   <TableColumn fx:id="factClienteColumn" text="Cliente" prefWidth="180"/>
   <TableColumn fx:id="factFechaColumn" text="Fecha" prefWidth="130"/>
   <TableColumn fx:id="factSubtotalColumn" text="Subtotal" prefWidth="110"/>
   <TableColumn fx:id="factDeliveryColumn" text="Delivery" prefWidth="90"/>
   <TableColumn fx:id="factImpuestoColumn" text="ITBIS" prefWidth="90"/>
   <TableColumn fx:id="factTotalColumn" text="Total" prefWidth="120"/>
   <TableColumn fx:id="factEstadoColumn" text="Estado" prefWidth="100"/>
  </columns>
  <placeholder><Label text="No hay facturas generadas." styleClass="text-muted"/></placeholder>
 </TableView>
</VBox>
