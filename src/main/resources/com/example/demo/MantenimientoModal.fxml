<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.MantenimientoModalController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>
 
 <padding>
 <Insets top="20" right="20" bottom="20" left="20"/>
 </padding>
 
 <!-- Title -->
 <Label fx:id="tituloLabel" text="Registrar Mantenimiento" style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>
 
 <!-- Form Fields -->
 <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
 <Label text="Máquina:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
 <ComboBox fx:id="maquinaComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
 
 <Label text="Fecha Mantenimiento:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
 <DatePicker fx:id="fechaMantenimientoPicker" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
 
 <Label text="Tipo:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
 <ComboBox fx:id="tipoComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
 
 <Label text="Descripción:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
 <TextArea fx:id="descripcionTextArea" styleClass="form-field" prefWidth="250" prefHeight="80" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
 
 <Label text="Próximo Mantenimiento:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
 <DatePicker fx:id="proximoMantenimientoPicker" styleClass="form-field" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
 
 <Label text="Precio Total:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
 <TextField fx:id="precioTotalField" promptText="Costo total del mantenimiento" styleClass="form-field" prefWidth="250" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
 </GridPane>
 
 <!-- Action Buttons -->
 <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
 <Button fx:id="limpiarButton" text="Limpiar" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;" onAction="#limpiarCampos"/>
 <Button fx:id="cancelarButton" text="Cancelar" onAction="#cancelarMantenimiento" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button fx:id="guardarButton" text="Registrar" onAction="#guardarMantenimiento" style="-fx-background-color: #f55580; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 </HBox>
</VBox>
