<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.PersonalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <!-- Header -->
    <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="20" right="20" bottom="15" left="20"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="👥 Gestión de Personal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="contratarButton" text="➕ Contratar Empleado" onAction="#contratar" style="-fx-background-color: #8B5E3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: #FAFAFA;">
        <VBox style="-fx-padding: 20; -fx-spacing: 20;" alignment="TOP_CENTER">

            <!-- Filters Section -->
            <HBox style="-fx-background-color: #F8F9FA; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-padding: 15;" alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🔍 Búsqueda" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                    <HBox spacing="10" alignment="CENTER">
                        <TextField fx:id="buscarField" promptText="🔍 Buscar por nombre, cédula o teléfono" styleClass="form-field" prefWidth="300"/>
                        <Button fx:id="buscarButton" text="🔍 Buscar" style="-fx-background-color: #8B5E3C; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15;"/>
                    </HBox>
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="📊 Filtros" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                    <HBox spacing="10" alignment="CENTER">
                        <VBox spacing="5">
                            <Label text="Área:" style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>
                            <ComboBox fx:id="areaFilter" styleClass="form-field" prefWidth="150"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Estado:" style="-fx-font-size: 12px; -fx-text-fill: #666666;"/>
                            <ComboBox fx:id="estadoFilter" styleClass="form-field" prefWidth="150"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="filtrarButton" text="🔍 Filtrar" style="-fx-background-color: #8B5E3C; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15;"/>
                        <Button fx:id="limpiarFiltrosButton" text="🧹 Limpiar Filtros" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15 8 15;"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Employees Table -->
            <VBox spacing="15" alignment="TOP_CENTER">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="📋 Lista de Empleados" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" text="Total: 0 empleados" style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>
                </HBox>

                <TableView fx:id="empleadosTable" styleClass="personnel-table">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="cedulaColumn" text="Cédula" prefWidth="120"/>
                        <TableColumn fx:id="telefonoColumn" text="Teléfono" prefWidth="100"/>
                        <TableColumn fx:id="areaColumn" text="Área" prefWidth="120"/>
                        <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="100"/>
                        <TableColumn fx:id="capacitacionColumn" text="Capacitación" prefWidth="120"/>
                        <TableColumn fx:id="accionesColumn" text="Acciones" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
