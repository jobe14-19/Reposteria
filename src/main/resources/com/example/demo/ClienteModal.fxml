<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.ClienteModalController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

 <padding>
 <Insets top="20" right="20" bottom="20" left="20"/>
 </padding>

 <spacing>15</spacing>

 <!-- Title -->
 <Label fx:id="tituloLabel" text="Nuevo Cliente" style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="text-heading"/>

 <!-- Form Fields -->
 <GridPane hgap="15" vgap="15" alignment="CENTER_LEFT">
 <Label text="Nombre:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
 <TextField fx:id="nombreField" promptText="Ingrese el nombre del cliente" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

 <Label text="Apellido:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
 <TextField fx:id="apellidoField" promptText="Ingrese el apellido del cliente" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

 <Label text="Teléfono:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
 <TextField fx:id="telefonoField" promptText="Ingrese el teléfono del cliente" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

 <Label text="Email:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
 <TextField fx:id="emailField" promptText="Ingrese el email del cliente" styleClass="form-field" prefWidth="250" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

 <Label text="Dirección:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
 <TextField fx:id="direccionField" promptText="Ingrese la dirección del cliente" styleClass="form-field" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

 <Label text="RNC/Cédula:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
 <TextField fx:id="rncField" promptText="Ingrese RNC o Cédula" styleClass="form-field" prefWidth="250" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

 <Label text="Usuario:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
 <TextField fx:id="usuarioField" promptText="Nombre de usuario para el sistema" styleClass="form-field" prefWidth="250" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

 <Label text="Contraseña:" style="-fx-font-size: 14px; -fx-font-weight: bold;" styleClass="text-heading-sm" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
 <PasswordField fx:id="contrasenaField" styleClass="form-field" prefWidth="250" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
 </GridPane>

 <!-- Action Buttons -->
 <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
 <Button fx:id="eliminarButton" text="Eliminar" onAction="#eliminar" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button fx:id="limpiarButton" text="Limpiar" onAction="#limpiarCampos" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 <Button fx:id="cancelarButton" text="Cancelar" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;" onAction="#cancelarResultado"/>
 <Button fx:id="guardarResultado" text="Guardar" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;" onAction="#guardarResultado"/>
 </HBox>
</VBox>
