<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.PedidoDetalleModalController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

 <padding>
 <Insets top="20" right="20" bottom="20" left="20"/>
 </padding>

 <spacing>15</spacing>

 <!-- Title -->
  <Label fx:id="tituloLabel" text="Detalle del Pedido" style="-fx-font-size: 20px;" styleClass="text-heading"/>

  <!-- Order Details -->
  <VBox spacing="10" alignment="TOP_LEFT" style="-fx-border-radius: 8; -fx-padding: 15;" styleClass="bg-input border-light">
  <Label text="Información del Pedido" style="-fx-font-size: 16px;" styleClass="text-heading"/>

 <GridPane hgap="15" vgap="10" alignment="CENTER_LEFT">
 <Label text="ID Pedido:" styleClass="text-muted-sm" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
 <Label fx:id="pedidoIdLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

 <Label text="Producto:" styleClass="text-muted-sm" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
 <Label fx:id="productoLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

 <Label text="Libras:" styleClass="text-muted-sm" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
 <Label fx:id="librasLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

 <Label text="Fecha Entrega:" styleClass="text-muted-sm" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
 <Label fx:id="fechaEntregaLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

 <Label text="Total:" styleClass="text-muted-sm" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
 <Label fx:id="totalLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

 <Label text="Estado:" styleClass="text-muted-sm" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
 <Label fx:id="estadoLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
 </GridPane>
 </VBox>

  <!-- Design and Observations -->
  <VBox spacing="10" alignment="TOP_LEFT" style="-fx-border-radius: 8; -fx-padding: 15;" styleClass="bg-input border-light">
  <Label text="Diseño y Observaciones" style="-fx-font-size: 16px;" styleClass="text-heading"/>

 <VBox spacing="10" alignment="TOP_LEFT">
 <VBox spacing="5" alignment="TOP_LEFT">
  <Label text="Diseño:" styleClass="text-muted-sm"/>
 <TextArea fx:id="disenoTextArea" styleClass="form-field" prefWidth="500" prefHeight="60" editable="false" wrapText="true"/>
 </VBox>

 <VBox spacing="5" alignment="TOP_LEFT">
  <Label text="Observaciones:" styleClass="text-muted-sm"/>
 <TextArea fx:id="observacionesTextArea" styleClass="form-field" prefWidth="500" prefHeight="60" editable="false" wrapText="true"/>
 </VBox>
 </VBox>
 </VBox>

  <!-- Timeline -->
  <VBox spacing="10" alignment="TOP_LEFT" style="-fx-border-radius: 8; -fx-padding: 15;" styleClass="bg-input border-light">
  <Label text="Timeline Histórico" style="-fx-font-size: 16px;" styleClass="text-heading"/>

  <ListView fx:id="timelineListView" prefHeight="150" style="-fx-border-radius: 6; -fx-padding: 5;" styleClass="bg-card border-light"/>
 </VBox>

 <!-- Action Buttons -->
 <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
 <Button fx:id="cerrarResultado" text="Cerrar" onAction="#cerrarResultado" style="-fx-background-color: #b0a8a5; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
 </HBox>
</VBox>
