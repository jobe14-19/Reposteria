<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="15" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.CapacitacionRecetasController">
 <stylesheets><URL value="@styles.css"/></stylesheets>
 <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

 <Label text="Capacitacion de Recetas" style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>

 <HBox spacing="15" alignment="CENTER_LEFT">
  <TextField fx:id="buscarField" promptText="Buscar por nombre, categoria o producto..." maxWidth="400" styleClass="form-field"/>
  <Label fx:id="totalLabel" text="Total: 0 recetas" style="-fx-text-fill: #999; -fx-font-style: italic;"/>
 </HBox>

 <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent;">
  <VBox fx:id="recetasContainer" spacing="12" maxWidth="Infinity"/>
 </ScrollPane>
</VBox>
