<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<VBox spacing="20" styleClass="root bg-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.ReportesController">
  <stylesheets>
  <URL value="@styles.css"/>
  </stylesheets>
  <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="bg-card">
  <VBox spacing="20" style="-fx-padding: 20;">
  <Label text="Gestion de Reportes" style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>

 <VBox spacing="8">
 <Label text="Seleccionar Reporte:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
 <ComboBox fx:id="reporteComboBox" prefHeight="35" prefWidth="400"/>
 </VBox>

 <VBox spacing="8">
 <Label fx:id="parametrosLabel" text="Parámetros:" style="-fx-font-size: 12px; -fx-font-style: italic;"/>
 <TextField fx:id="parametroField1" visible="false" prefWidth="200"/>
 <HBox spacing="10">
 <DatePicker fx:id="fechaInicioPicker" visible="false" prefWidth="200"/>
 <DatePicker fx:id="fechaFinPicker" visible="false" prefWidth="200"/>
 </HBox>
 </VBox>

 <HBox spacing="15">
 <Button fx:id="vistaPreviaButton" text="Vista Previa" onAction="#vistaPrevia"
 style="-fx-background-color: #f55580; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8;"/>
 <Button fx:id="exportarPdfButton" text="Exportar PDF" onAction="#exportarPdf"
 style="-fx-background-color: #CC0000; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8;"/>
 <Button fx:id="exportarXlsxButton" text="Exportar Excel" onAction="#exportarXlsx"
 style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8;"/>
 <Button text="Cerrar" onAction="#cerrar"
 style="-fx-background-color: #9a7a75; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25; -fx-background-radius: 8;"/>
 </HBox>

  <Label fx:id="statusLabel" text="Listo" style="-fx-font-size: 12px;" styleClass="text-muted-sm"/>
  </VBox>
 </ScrollPane>
</VBox>
