<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.LimpiezaController">
 <stylesheets>
 <URL value="@styles.css"/>
 </stylesheets>

 <!-- Header -->
 <VBox styleClass="bg-card border-light" style="-fx-border-width: 0 0 1 0;">
 <padding>
 <Insets top="20" right="20" bottom="15" left="20"/>
 </padding>

 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label text="Limpieza e Higiene" style="-fx-font-size: 24px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Button fx:id="registrarLimpiezaButton" text="Registrar Limpieza" style="-fx-background-color: #f55580; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>

 </HBox>
 </VBox>

 <!-- Main Content -->
 <ScrollPane fitToWidth="true" styleClass="bg-primary">
 <VBox style="-fx-padding: 20; -fx-spacing: 20;" alignment="TOP_CENTER">

 <!-- Materials Checklist -->
 <VBox spacing="15" alignment="TOP_CENTER">
 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label text="Checklist de Materiales" style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="text-heading-lg"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Button fx:id="actualizarMaterialesButton" text="Inventario" style="-fx-background-color: #f0ad4e; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;"/>
 </HBox>

 <VBox fx:id="checklistContainer" style="-fx-background-radius: 12; -fx-border-width: 1; -fx-padding: 15;" styleClass="bg-input border-light" spacing="8" alignment="TOP_LEFT">
 <Label text="Cargando..." style="-fx-font-size: 13px;" styleClass="text-muted-sm"/>
 </VBox>

 <HBox spacing="10" alignment="CENTER_LEFT">
 <TextField fx:id="nuevoItemField" promptText="Nuevo material para el checklist..." HBox.hgrow="ALWAYS" style="-fx-font-size: 13px; -fx-padding: 8 12 8 12; -fx-background-radius: 6;"/>
 <Button fx:id="agregarItemButton" text="Agregar" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-background-radius: 6; -fx-cursor: hand;"/>
 </HBox>
 </VBox>

 <!-- Cleaning Control Table -->
 <VBox spacing="15" alignment="TOP_CENTER">
 <HBox alignment="CENTER_LEFT" spacing="15">
 <Label text="Control de Limpieza" style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="text-heading-lg"/>
 <Region HBox.hgrow="ALWAYS"/>
 <Label fx:id="totalLabel" text="Total: 0 áreas" style="-fx-font-size: 14px;" styleClass="text-muted-sm"/>
 </HBox>

 <TableView fx:id="limpiezaTable" styleClass="cleaning-table">
 <columns>
 <TableColumn fx:id="areaColumn" text="Área/Equipo" prefWidth="150"/>
 <TableColumn fx:id="ultimaLimpiezaColumn" text="Última Limpieza" prefWidth="120"/>
 <TableColumn fx:id="diasSinLimpiezaColumn" text="Días sin Limpieza" prefWidth="120"/>
 <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="100"/>
 <TableColumn fx:id="accionColumn" text="Acción" prefWidth="150"/>
 </columns>
 </TableView>
 </VBox>
 </VBox>
 </ScrollPane>
</VBox>
