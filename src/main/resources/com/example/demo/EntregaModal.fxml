<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox styleClass="root" spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.EntregaModalController">
    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="tipoEntregaGroup"/>
    </fx:define>

    <!-- Title -->
    <Label fx:id="tituloLabel" text="Registrar Entrega y Cobro" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

    <!-- Order Details -->
    <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #F8F9FA; -fx-border-color: #E0E0E0; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15;">
        <Label text="📋 Datos del Pedido" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

        <GridPane hgap="15" vgap="10" alignment="CENTER_LEFT">
            <Label text="ID Pedido:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="pedidoIdLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Cliente:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="clienteLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Total:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="totalLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Adelanto:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="adelantoLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Saldo Pendiente:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="saldoLabel" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- Delivery Type -->
    <VBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Tipo de Entrega" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <RadioButton fx:id="localRadioButton" text="🏪 Recogida en Local" toggleGroup="$tipoEntregaGroup" selected="true" style="-fx-font-size: 14px; -fx-text-fill: #333333;"/>
            <RadioButton fx:id="deliveryRadioButton" text="🚗 Delivery" toggleGroup="$tipoEntregaGroup" style="-fx-font-size: 14px; -fx-text-fill: #333333;"/>
        </HBox>
    </VBox>

    <!-- Delivery Details (shown only for delivery) -->
    <VBox fx:id="deliveryDetails" spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #E3F2FD; -fx-border-color: #007BFF; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 15;">
        <Label text="📍 Detalles de Delivery" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #007BFF;"/>

        <GridPane hgap="15" vgap="10" alignment="CENTER_LEFT">
            <Label text="Dirección:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="direccionField" promptText="Dirección de entrega" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Distancia (km):" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="distanciaField" promptText="Distancia en km" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Costo Delivery:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="costoDeliveryField" promptText="Costo calculado" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- Payment Details -->
    <VBox spacing="10" alignment="CENTER_LEFT">
        <Label text="💰 Detalles de Pago" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8B5E3C;"/>

        <GridPane hgap="15" vgap="10" alignment="CENTER_LEFT">
            <Label text="Monto a Cobrar:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="montoCobrarField" styleClass="form-field" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Método de Pago:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="metodoPagoComboBox" styleClass="form-field" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Referencia:" style="-fx-font-size: 12px; -fx-text-fill: #666666;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="referenciaField" promptText="Referencia (obligatorio si != Efectivo)" styleClass="form-field" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding-top: 20;">
        <Button fx:id="limpiarButton" text="Limpiar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;" onAction="#limpiarCampos"/>
        <Button fx:id="cancelarButton" text="Cancelar" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="guardarResultado" text="Registrar Pago y Completar Entrega" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>
</VBox>
