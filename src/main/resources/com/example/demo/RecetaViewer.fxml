<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox spacing="15" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controller.RecetaViewerController">
 <stylesheets><URL value="@styles.css"/></stylesheets>
 <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

 <HBox alignment="CENTER_LEFT" spacing="15">
  <Label fx:id="tituloLabel" text="Detalle de Receta" style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="text-heading-xl"/>
  <Region HBox.hgrow="ALWAYS"/>
  <Label fx:id="modoLabel" text="MODO" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-padding: 4 12; -fx-background-radius: 12; -fx-font-size: 11px; -fx-font-weight: bold;"/>
 </HBox>

 <VBox style="-fx-background-color: #FFF8F0; -fx-border-color: #E8D5C0; -fx-border-radius: 10; -fx-padding: 15; -fx-spacing: 8;">
  <Label fx:id="nombreLabel" text="-" style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="text-heading-lg"/>
  <HBox spacing="20">
   <Label fx:id="productoLabel" text="Producto: -"/>
   <Label fx:id="categoriaLabel" text="Categoria: -"/>
   <Label fx:id="tiempoLabel" text="Tiempo: -"/>
  </HBox>
  <HBox spacing="20">
   <Label fx:id="cantidadLabel" text="Cantidad: -"/>
   <Label fx:id="costoLabel" text="Costo: -"/>
   <Label fx:id="rendimientoLabel" text="Rendimiento: -"/>
   <Label fx:id="desperdicioLabel" text="Desperdicio: -"/>
  </HBox>
 </VBox>

 <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">
  <Tab fx:id="ingredientesTab" text="Ingredientes" closable="false">
   <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
    <VBox fx:id="ingredientesContainer" spacing="8" maxWidth="Infinity" style="-fx-padding: 15;"/>
   </ScrollPane>
  </Tab>
  <Tab fx:id="procedimientoTab" text="Procedimiento" closable="false">
   <VBox spacing="10">
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent;">
     <VBox fx:id="pasosContainer" spacing="12" maxWidth="Infinity" style="-fx-padding: 15;"/>
    </ScrollPane>
    <HBox fx:id="navegacionBox" alignment="CENTER" spacing="20" visible="false" managed="false" style="-fx-padding: 10 0 0 0;">
     <Button fx:id="anteriorPasoButton" text="<- Anterior" styleClass="btn-secondary" onAction="#anteriorPaso"/>
     <Label fx:id="pasoContadorLabel" text="Paso 1 de 1" style="-fx-font-weight: bold;" styleClass="text-heading"/>
     <Button fx:id="siguientePasoButton" text="Siguiente ->" styleClass="btn-primary" onAction="#siguientePaso"/>
    </HBox>
   </VBox>
  </Tab>
  <Tab fx:id="costosTab" text="Costos y Produccion" closable="false">
   <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
    <VBox fx:id="costosContainer" spacing="8" maxWidth="Infinity" style="-fx-padding: 15;"/>
   </ScrollPane>
  </Tab>
 </TabPane>

 <HBox alignment="CENTER_RIGHT">
  <Button fx:id="cerrarButton" text="Cerrar" styleClass="btn-secondary" onAction="#cerrar"/>
 </HBox>
</VBox>
