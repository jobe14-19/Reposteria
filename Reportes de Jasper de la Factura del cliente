	<parameter name="ID_FACTURA" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT 
    f.id_factura,
    f.fecha_venta,
    p.fecha_entrega,
    p.estado,
    c.nombre_cliente,
    df.producto_nombre,
    df.cantidad,
    df.precio_unitario,
    (df.cantidad * df.precio_unitario) AS subtotal,
    f.total_pago
FROM Facturas f
INNER JOIN Pedidos p ON f.id_pedido = p.id_pedido
INNER JOIN Clientes c ON p.id_cliente = c.id_cliente
INNER JOIN DetalleFactura df ON f.id_factura = df.id_factura
WHERE f.id_factura = $P{ID_FACTURA}
ORDER BY f.id_factura DESC]]></query>
